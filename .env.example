# Server
PORT=3900
NODE_ENV=development

# Database (PostgreSQL on Arcana-DBS via Tailscale)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Redis (Arcana-DBS via Tailscale)
REDIS_HOST=100.97.136.74
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=conn:

# Auth
API_KEY_SALT_ROUNDS=10
ADMIN_TOKEN=  # Min 32 chars. Required for /admin/keys endpoints. Generate: openssl rand -hex 32

# CTRL-0026 Phase 2: purpose-scoped read token for GET /stats/requests/daily
# (StatsReadGuard). Min 32 chars. Generate: openssl rand -hex 32
STATS_READ_TOKEN=

# Connectors
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TIMEOUT_MS=120000
AZURE_OPENAI_MAX_CONCURRENCY=10
CONNECTOR_TIMEOUT_MS=300000
CONNECTOR_MAX_CONCURRENCY=1

# Amazon Bedrock (CONN-0244) — non-secret routing only. The host injects SigV4 signing.
BEDROCK_REGION=us-east-1
BEDROCK_MODELS=amazon.nova-lite-v1:0,anthropic.claude-3-5-sonnet-20241022-v2:0

# Codex CLI (CONN-0062)
CODEX_MAX_CONCURRENCY=4

# Codex sidecar — Vault AppRole credentials (operator-provisioned, never committed).
# Read role: entrypoint fetches the OAuth blob from Vault (read-only).
CODEX_VAULT_ROLE_ID=
CODEX_VAULT_SECRET_ID=
# Writeback role (CONN-0222): dedicated AppRole, create+update on
# arcanada/data/prod/env/codex-cli only. Consumed by codex-oauth-writeback.sh to
# persist the rotated OAuth token back to Vault (KV-v2 CAS). Empty = writeback
# disabled (fail-open) until the operator provisions the role (H1). Distinct from
# the read role above; HCL draft in
# documentation/infrastructure/vault-secondary-bootstrap/codex-oauth-recovery.md.
CODEX_WRITEBACK_ROLE_ID=
CODEX_WRITEBACK_SECRET_ID=

# Cursor CLI (standalone agent binary)
CURSOR_API_KEY=

# OpenRouter API
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_TIMEOUT_MS=120000
PERPLEXITY_MAX_CONCURRENCY=10

# Native OpenAI Responses API (also shares OPENAI_API_KEY with OpenAI Images)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_CONCURRENCY=10

# xAI (Grok) API
# XAI_API_KEY is injected by the deployment secret mechanism when Grok is enabled.
GROK_MAX_CONCURRENCY=10

# Cohere native API (CONN-0247)
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
COHERE_TIMEOUT_MS=120000
COHERE_MAX_CONCURRENCY=10

# Embedding API (BGE-M3 on arcana-db via Tailscale)
EMBEDDING_API_URL=http://100.70.137.104:8300
EMBEDDING_TIMEOUT_MS=30000

# OpenModel API (CONN-0223)
# Cloudflare Workers AI native REST API (CONN-0252; optional)
CLOUDFLARE_WORKERS_AI_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_WORKERS_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_WORKERS_AI_TIMEOUT_MS=120000
CLOUDFLARE_WORKERS_AI_MAX_CONCURRENCY=4

# CONN-0244: OpenModel is a PAID gateway — it has NO free models. Leave OPENMODEL_FREE_MODELS
# EMPTY unless the account genuinely receives a provider free allowance; a stray value here
# re-introduces the false-free bug that drove paid traffic through the free cascade.
OPENMODEL_ENABLED=false
OPENMODEL_API_KEY=
OPENMODEL_BASE_URL=https://api.openmodel.ai/v1
OPENMODEL_FREE_MODELS=
OPENMODEL_TIMEOUT_MS=30000
OPENMODEL_MAX_CONCURRENCY=2

# Native Anthropic Messages API connector (default-off).
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TIMEOUT_MS=120000
ANTHROPIC_MAX_CONCURRENCY=4

# Low-reasoning cascade router (CONN-0223)
# CONN-0244: DEEPENED to ~7 live free rungs across groq + openrouter (each prod-probed:
# status=success, cost=0), interleaved for cross-provider resilience. free rungs must be
# GENUINELY free — do NOT put openmodel:* (paid) on a :free rung. Model ids may NOT contain a
# colon (tier = text after the last colon), so openrouter `:free`-suffixed ids are unusable here.
CASCADE_LOW_REASONING_ORDER=groq:llama-3.3-70b-versatile:free,groq:llama-3.1-8b-instant:free,openrouter:meta-llama/llama-4-maverick:free,groq:meta-llama/llama-4-scout-17b-16e-instruct:free,groq:openai/gpt-oss-120b:free,openrouter:openrouter/free:free,groq:qwen/qwen3-32b:free,openrouter:deepseek-v4-flash:paid

# Per-provider access (CONN-0244) — CSV `name:level` (level = use | read | none):
#   use  = fully enabled (default for any provider not listed)
#   read = visible in catalog but NOT routable (no cascade, no /execute) — marked access:read-only
#   none = hidden from the catalog entirely
# Default keeps OpenModel visible-but-not-routable (paid gateway the operator cannot fund).
PROVIDER_ACCESS=openmodel:read
CASCADE_PAID_ENABLED=false
CASCADE_PAID_DAILY_BUDGET_USD=0.17
CASCADE_PAID_MODEL=deepseek-v4-flash

# CONN-0245 catalog cron/cache — DB (model_catalog table) is the single source of
# truth for GET /connectors/catalog; these only control the background refresh
# cadence and the optional Redis accelerator cache in front of the DB read path.
# provider_access DB table is seeded create-only from PROVIDER_ACCESS above (config
# seeds defaults, DB is the authoritative runtime state after first seed).
CATALOG_FULL_REFRESH_CRON=*/15 * * * *
# CATALOG_STATUS_REFRESH_MS: lightweight per-connector getStatus() poll — flips
#   status online/offline only, never touches pricing/capabilities.
CATALOG_STATUS_REFRESH_MS=300000
# CATALOG_CACHE_TTL_MS: Redis cache TTL over the DB read path; CATALOG_CACHE_ENABLED=false
#   fully skips Redis get/set.
CATALOG_CACHE_TTL_MS=30000
CATALOG_CACHE_ENABLED=true

# ElevenLabs native audio client (CONN-0260). Keep the real value in Vault.
ELEVENLABS_API_KEY=

# Speech proxy to Transcribator API (TRANS-0035). The two stacks are separate
# docker-compose projects — the schema default (http://localhost:3700) only
# resolves inside THIS container, never to the transcribator-api container
# (CONN-0214: was silently 502-ing upstream_unavailable on every tts/stt/vad
# call on PROD). docker-compose.yml joins the `transcribator-api_default`
# external network; on PROD, set this to the transcribator-api container's
# compose service name, e.g.:
# TRANSCRIBATOR_API_URL=http://transcribator-api-api-1:3700
TRANSCRIBATOR_API_URL=http://localhost:3700
SPEECH_INTERNAL_TOKEN=
SPEECH_PROXY_TIMEOUT_MS=30000
# Native Vertex AI generative connector (non-secret configuration only).
# Authentication is supplied by an injected async bearer-token provider.
VERTEX_GENERATIVE_PROJECT=unconfigured-project
VERTEX_GENERATIVE_LOCATION=us-central1
VERTEX_GENERATIVE_MODELS=gemini-2.5-flash
FIREWORKS_API_KEY=
FIREWORKS_TIMEOUT_MS=120000
FIREWORKS_MAX_CONCURRENCY=10
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=300000
OLLAMA_MAX_CONCURRENCY=2

# Native Deepgram Aura-1 TTS (default-off). Keep the provider key server-side;
# never expose it to browser code. The base URL is validated against the exact
# official HTTPS API origin.
TTS_PROVIDER_DEEPGRAM_ENABLED=false
TTS_DEEPGRAM_API_KEY=
TTS_DEEPGRAM_BASE_URL=https://api.deepgram.com
TTS_DEEPGRAM_TIMEOUT_MS=30000

# Together Orpheus TTS (CONN-0311). Disabled until the secret is provisioned.
TTS_PROVIDER_TOGETHER_ENABLED=false
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.ai/v1
TTS_TOGETHER_TIMEOUT_MS=60000
# OpenAI-compatible failover gateway — POST /v1/chat/completions (CONN-0243).
# Free-first provider priority (highest first). DeepSeek (openmodel) is always
# promoted ahead of the rest within the free tier regardless of this order.
FAILOVER_PROVIDER_ORDER=openmodel,groq,openrouter,gemini
# The model id that represents DeepSeek's default free hop.
FAILOVER_DEEPSEEK_MODEL=deepseek-v4-flash
# Append paid candidates after all free ones. Default OFF (free-only gateway).
FAILOVER_PAID_ENABLED=false
# When true (default), a client-requested model that fails or is unknown falls back
# to the free-first chain (the Hermes use case). Set false for strict callers that
# must not silently downgrade a requested paid model to a free one.
FAILOVER_ALLOW_FREE_DOWNGRADE=true

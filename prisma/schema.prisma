generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Request {
  id           String   @id @default(uuid())
  connector    String
  model        String?
  promptHash   String
  promptLength Int
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  // ARAS-0058 — WHERE `costUsd` came from, as a first-class column rather than
  // something a reader has to infer from the number itself. Zero is ambiguous:
  // a free model, a request that consumed nothing, and a model whose price we
  // never knew all settle at $0.000000, and only the last of those is a revenue
  // leak. See `src/billing/measured-cost.ts` (CostSource) for the values.
  //
  // Nullable with no default: rows written before this shipped genuinely do not
  // know their provenance, and back-filling them with a guess would invent
  // evidence. NULL means "predates the meter".
  costSource   String?
  latencyMs    Int
  status       String // 'success', 'error', 'timeout', 'rate_limited'
  errorType    String?
  errorMessage String?
  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id])
  // CONN-0089 output-guard middleware envelope (nullable for backward-compat)
  repairReport Json?
  createdAt    DateTime @default(now())

  @@index([connector, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([status])
}

model ApiKey {
  id                String             @id @default(uuid())
  name              String
  keyHash           String             @unique
  rateLimit         Int                @default(60)
  active            Boolean            @default(true)
  requests          Request[]
  imageGenerations  ImageGeneration[]
  sttTranscriptions SttTranscription[]
  firstDispatchObservations FirstDispatchObservation[]
  // CONN-1665 — per-key access policy. Shape's single source of truth is the
  // Zod schema `apiKeyPolicySchema` in src/policy/policy.schema.ts — validated
  // at WRITE time by the admin API; never write this column outside that path.
  // Null = legacy unrestricted key (all providers/models, shared env keys).
  policy            Json?
  creditsBalance    CreditsBalance?
  creditsLedger     CreditsLedger[]
  requestIntents    RequestIntent[]
  createdAt         DateTime           @default(now())
}

model FirstDispatchObservation {
  id                         String   @id
  apiKeyId                   String
  apiKey                     ApiKey   @relation(fields: [apiKeyId], references: [id])
  observationKeySha256       String   @unique
  measurement                Json
  connector                  String
  requestedModel             String?
  requestPayloadDigestSha256 String
  requestPayloadBytes        Int
  observationBoundary        String
  connectorResponseId        String?
  observedModel              String?
  inputTokens                Int?
  outputTokens               Int?
  totalTokens                Int?
  costUsd                    Decimal? @db.Decimal(20, 12)
  latencyMs                  Int?
  outcome                    String?
  usageSource                String?
  persistence                String
  evidenceStatus             String
  authorization              String
  failureStage               String?
  receipt                    Json?
  receiptDigestSha256        String?  @unique
  state                      String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([apiKeyId, createdAt])
  @@index([state, createdAt])
}

model ConnectorAccount {
  id             String  @id @default(uuid())
  connector      String
  accountName    String
  credentials    String
  maxConcurrency Int     @default(1)
  active         Boolean @default(true)

  @@unique([connector, accountName])
}

// CONN-0052: Image Generation models
// PK uses app-side UUID v7 (uuidv7 lib) — NOT @default(uuid()) which is v4
// Migration deferred to Phase 1 (pnpm db:migrate)

model ImageGeneration {
  id            String   @id // UUID v7, set by application layer
  apiKeyId      String
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id])
  provider      String // 'vertex' | 'replicate' | 'openai-images'
  model         String
  prompt        String
  negativePrompt String?
  width         Int      @default(1024)
  height        Int      @default(1024)
  steps         Int?
  cfg           Float?   // classifier-free guidance scale
  seed          Int?
  aspectRatio   String?  // e.g. '16:9', '1:1'
  outputFormat  String   @default("png") // 'png' | 'jpeg' | 'webp'
  status        String   // 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled'
  resultUrl     String?  // presigned R2 URL or direct URL
  r2Key         String?  // R2 object key for storage management
  costUsd       Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs     Int?
  errorType     String?
  errorMessage  String?
  metadata      String?  // JSON blob for provider-specific fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  jobs          ImageJob[]

  @@index([provider, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([status])
}

model ImageJob {
  id              String          @id // UUID v7, set by application layer
  imageGenerationId String
  imageGeneration ImageGeneration @relation(fields: [imageGenerationId], references: [id])
  bullJobId       String?         // BullMQ job ID for async tracking
  attempt         Int             @default(1)
  status          String          // 'queued' | 'processing' | 'completed' | 'failed'
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([imageGenerationId])
  @@index([bullJobId])
  @@index([status, createdAt])
}

// CONN-0102: STT multi-provider router audit row
// PK = UUID v7 (app-side via uuidv7 lib) for time-sortable scans.
// CONN-0103: adds fallbackCount + driftStatus (Phase 1b cascade audit).
// CONN-0104: adds mode (sync|async) + jobId (uuidv7) for Phase 2 async pipeline.
model SttTranscription {
  id                   String   @id // UUID v7, set by application layer
  apiKeyId             String
  apiKey               ApiKey   @relation(fields: [apiKeyId], references: [id])
  provider             String // 'groq' | 'deepgram' | 'assemblyai' | 'openai' | 'local-whisper'
  model                String
  language             String?
  audioBytes           Int
  audioDurationSeconds Float?
  mimeType             String
  transcriptionPreview String // first 80 chars of returned transcription (PII surface — keep short)
  costUsd              Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs            Int
  status               String // 'success' | 'error' | 'queued' | 'processing' (async-only states)
  errorType            String? // includes 'drift' from Phase 1b
  errorMessage         String?
  requestId            String?
  fallbackCount        Int      @default(0) // cascade hops before this row landed
  driftStatus          String? // null | 'schema_pass' | 'schema_fail' (Phase 1b drift detection)
  mode                 String   @default("sync") // 'sync' | 'async' (CONN-0104)
  jobId                String?  @unique // BullMQ job id (uuidv7) — only set for mode='async'
  createdAt            DateTime @default(now())

  @@index([provider, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([status])
}

// CONN-0245: DB as single source of truth for the model catalog.
// Populated exclusively by CatalogRefreshService (cron full-refresh +
// interval status-refresh) — the getCatalog() request path only ever reads
// this table (+ optional Redis cache), never calls a provider directly.
// Rows are never deleted: when a model disappears from a provider's live
// list, `absent` flips to true and the last-known data is retained for
// history/audit instead of losing the row.
model ModelCatalog {
  id                 String   @id @default(cuid())
  connector          String
  model              String
  modality           String
  status             String // "online" | "offline"
  lastChecked        DateTime
  supportsStreaming  Boolean  @default(false)
  supportsJsonSchema Boolean  @default(false)
  supportsTools      Boolean  @default(false)
  inputPerMTok       Float?
  outputPerMTok      Float?
  priceUnit          String   @default("USD/1M tokens")
  tier               String // "free" | "paid" | "unknown"
  free               Boolean  @default(false)
  // QA FIX B (Finding 1) — the legacy MC-side price multiplier (0 = free;
  // 1 = standard; null = unknown; OPENMODEL_CATALOGUE-sourced). Persisted
  // verbatim (not consulted for tier/free — see catalog-mapper.ts deriveTier)
  // so the external site's `cheap`/`priceMultiplier` fields survive the DB
  // round-trip unchanged instead of being fabricated on read.
  priceMultiplier    Float?
  contextWindow      Int?
  maxOutputTokens    Int?
  endpoint           String?
  executableHere     Boolean  @default(false)
  // CONN-0244 — per-provider USE access (`ProviderAccess.use`), persisted
  // verbatim so the read path can reconstruct the `access:read-only` tag.
  // NOT a compound of useEnabled && executableHere — availability for
  // routing is derived separately (see `available`, computed from `status`
  // at persist time in catalog-mapper.ts's entryToRow/rowToEntry).
  routable           Boolean  @default(false)
  firstSeen          DateTime @default(now())
  lastSeen           DateTime
  absent             Boolean  @default(false)
  // CONN-1646 — identity/provenance are nullable only for honest legacy rows
  // that predate transactional snapshots.
  snapshotId         String?
  contentFingerprint String?
  observedAt         DateTime
  source             String   @default("legacy-unknown")
  freshness          String   @default("unknown")
  absentSince        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  snapshot           CatalogSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@unique([connector, model])
  @@index([modality])
  @@index([status])
  @@index([snapshotId])
  @@map("model_catalog")
}

// CONN-1646 — one immutable identity for every applied provider observation,
// including sourced non-authoritative static boot floors.
model CatalogSnapshot {
  id            String              @id @default(cuid())
  connector     String
  fingerprint   String
  source        String
  observedAt    DateTime
  freshness     String
  authoritative Boolean
  rowCount      Int
  createdAt     DateTime            @default(now())
  modelRows     ModelCatalog[]
  driftEvents   CatalogDriftEvent[]

  @@index([connector, observedAt])
  @@map("catalog_snapshots")
}

// CONN-1646 — append-only provider drift derived inside the same serializable
// transaction as its snapshot and model row mutations.
model CatalogDriftEvent {
  id                String          @id @default(cuid())
  snapshotId        String
  connector         String
  model             String
  changeType        String
  beforeFingerprint String?
  afterFingerprint  String?
  changedFields     Json
  observedAt        DateTime
  createdAt         DateTime        @default(now())
  snapshot          CatalogSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([connector, observedAt])
  @@index([snapshotId])
  @@map("catalog_drift_events")
}

// CONN-0245-EXT — per-provider READ/USE access state. DB is authoritative;
// config (CATALOG_PROVIDER_USE_DEFAULT_OFF) only seeds defaults for a
// provider the FIRST time it's seen (create-only — see
// ProviderAccessService.seedDefaults). readEnabled gates catalog visibility;
// useEnabled gates whether MC routes traffic to it (execute()/cascade).
// Driving case: OpenModel is paid and the operator hasn't topped up ->
// readEnabled=true (still shown, real prices, not falsely free) /
// useEnabled=false (never routed).
model ProviderAccess {
  provider    String   @id
  readEnabled Boolean  @default(true)
  useEnabled  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("provider_access")
}

// ARAS-0064 — credit balance and ledger.
//
// The connector already MEASURED money (`Request.costUsd`) without ever
// SPENDING it. These two models close that gap: the ledger is the append-only
// record of every movement, and the balance is a materialised running total so
// a precheck is one indexed read rather than a sum over history.
//
// The ledger is the source of truth. If the two ever disagree, rebuild the
// balance from the ledger, never the other way round.
model CreditsBalance {
  apiKeyId   String   @id @map("api_key_id")
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  // 12,6 rather than Request.costUsd's 10,6: a balance accumulates many
  // requests, so it needs headroom the per-request column does not.
  //
  // ARAS-0058 — the database carries CHECK (balance_usd >= 0) and
  // CHECK (held_usd >= 0). Prisma's schema language cannot express a CHECK
  // constraint, so both live only in
  // `20260829120000_aras_0058_ledger_hardening/migration.sql`. They are not
  // decoration: application-level guards are the thing that races, and every
  // guarded write in BillingService is written on the assumption that if the
  // guard is ever bypassed the database refuses the row rather than silently
  // lending money. Do not drop them, and do not let a future `prisma migrate
  // dev` diff quietly regenerate this table without them.
  balanceUsd Decimal  @default(0) @map("balance_usd") @db.Decimal(12, 6)

  // ARAS-0058 — funds reserved by an in-flight request and not yet spent.
  // SPENDABLE balance is `balance_usd - held_usd`; `balance_usd` alone stays
  // the materialised SUM of the ledger, so the ledger remains the single
  // source of truth and a hold never has to be represented as a fake movement.
  // A hold is released (settled or abandoned) by RequestIntent; a crashed
  // process leaves one behind, which is what the expiry sweep exists for.
  heldUsd    Decimal  @default(0) @map("held_usd") @db.Decimal(12, 6)

  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("credits_balance")
}

model CreditsLedger {
  id String @id @default(uuid())

  apiKeyId String @map("api_key_id")

  // ARAS-0058 / BILL-0008 (consilium §6.4) — Restrict, NOT Cascade.
  //
  // It was Cascade, which meant revoking an API key DELETED its ledger history.
  // That was survivable while every row was either an operator gift or our own
  // measured spend. It stops being survivable the moment a row records money a
  // stranger actually sent: key revocation would destroy the financial record
  // of a real receipt, and crypto receipts are irreversible, so there is no
  // second copy anywhere to rebuild it from.
  //
  // Restrict means an ApiKey with ledger history cannot be deleted at all. That
  // is the intended answer, not a inconvenience to work around: a key with
  // money in its history is not a row to delete, it is a row to deactivate
  // (`ApiKey.active = false`, which the admin surface already does). Nothing in
  // the shipped code deletes an ApiKey; only integration specs do, and they
  // clear the ledger first.
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)

  // Signed: positive credits the account, negative debits it. One column rather
  // than a type discriminator plus a magnitude, so the balance is a plain SUM
  // and no reader can misinterpret a sign convention.
  amountUsd Decimal @map("amount_usd") @db.Decimal(12, 6)

  reason String

  // ARAS-0071 — what KIND of movement this is, as a first-class column rather
  // than a substring of `reason`. A gift must be distinguishable from money the
  // customer paid: they are the same arithmetic and completely different facts,
  // and an accounting history that cannot tell them apart cannot be audited.
  // Free-text `reason` is not enough — it is operator-supplied and unqueryable.
  //
  // 'charge'       = spend debited for a request
  // 'gift'         = credit granted by an operator, not paid for
  // 'credit'       = credit from any other source (pre-dates gifts)
  // 'payment'      = BILL-0008. Money a customer actually sent, credited from a
  //                  verified gateway event. Distinct from 'gift' because
  //                  revenue must never include money nobody paid, and distinct
  //                  from 'credit' because a payment has provenance (see the
  //                  columns below) that an operator top-up does not.
  // 'refund'       = BILL-0008. A NEGATIVE entry reversing a payment we chose to
  //                  return.
  // 'chargeback'   = BILL-0008. A NEGATIVE entry reversing a payment the
  //                  provider took back from us. Voluntary and involuntary
  //                  reversals are the same arithmetic and different facts, so
  //                  they are different types for the same reason gift and
  //                  payment are.
  // 'uncollectible'= ARAS-0058. A positive entry that writes off the part of a
  //                  charge the balance could not cover. The provider was
  //                  already paid, so the charge is ALWAYS recorded in full;
  //                  when it exceeds the balance the shortfall is written off
  //                  here rather than driving the balance negative. That keeps
  //                  `balance_usd = SUM(amount_usd)` true alongside
  //                  `CHECK (balance_usd >= 0)`, and makes revenue lost to
  //                  estimate overshoot a single queryable SUM instead of an
  //                  inference from a negative balance nobody looks at.
  //                  BILL-0008 gives it a second, symmetric use: the part of a
  //                  REVERSAL the balance could not give back, for exactly the
  //                  same reason in the opposite direction.
  //
  // ARAS-0058 / BILL-0008 — NO DEFAULT, and NOT NULL. It was
  // `@default("charge")`, so a caller that forgot the field posted a row
  // labelled a debit; a payment landing labelled 'charge' is a credit recorded
  // as spend, and no reader could tell. The permitted values are enforced by
  // `CHECK (entry_type IN (...))` in the migration — Prisma's schema language
  // cannot express it, and it must be the DATABASE that refuses, because the
  // whole failure mode is a write path nobody reviewed.
  entryType String @map("entry_type")

  // The anti-double-charge invariant, enforced by the DATABASE rather than by
  // application logic: a retried commit reuses its key and the unique
  // constraint rejects the second insert. A check in code would race.
  idempotencyKey String @unique @map("idempotency_key")

  // Set for a debit that settles a specific request; null for a manual credit.
  requestId String? @map("request_id")

  // ─────────────────────────────────────────────────────────────────────────
  // BILL-0008 — payment provenance and valuation.
  //
  // Every column below is UN-BACKFILLABLE, which is the whole reason they land
  // before the first payment rather than after it. The rate a crypto payment
  // was valued at is gone the instant it passes; the gateway reference is only
  // in the event that carried it; and whether a row was live or sandbox money
  // is not recoverable by inspection once both exist in the same table.
  //
  // All nullable, with NO default, for the same reason `Request.costSource` is:
  // rows written before this shipped genuinely have no provenance, and
  // back-filling them with a guess would invent evidence. NULL means "not a
  // payment" or "predates payments" — never "a payment we lost the details of",
  // because the migration's CHECK makes a payment row without provenance
  // impossible to write.

  /// The provider that took the money — 'oxapay', later 'paypal'/'stripe'.
  /// The ONLY provider-shaped string that crosses into the ledger; see the
  /// four-scalar `credit()` contract in consilium §2.
  source String?

  /// The gateway's own immutable reference (Oxapay's `track_id`). What a human
  /// reconciling our books against the gateway's dashboard joins on. Not
  /// unique here: a reversal legitimately carries the same external ref as the
  /// payment it reverses.
  externalRef String? @map("external_ref")

  /// Real money or sandbox money. Nullable ONLY because non-payment rows have
  /// no answer; a payment row without it is refused by the migration's CHECK.
  /// Consilium §5's sandbox trap: if the gateway's sandbox shares a signing key
  /// with live, this column is the only boundary there is.
  livemode Boolean?

  // The crypto valuation trio. The USD amount credited is `amount_usd` above —
  // THAT is the ledger number and the only one any money query may read. These
  // three are the audit record of how that USD number came to exist, kept
  // because "the customer paid 0.0031 BTC and we called it $180" is a claim we
  // must be able to reproduce later and cannot reconstruct.
  //
  // 38,18 rather than 12,6: a satoshi is 1e-8 BTC and a wei is 1e-18 ETH, so
  // the column has to hold an amount whose precision has nothing to do with
  // dollars. Deliberately NOT usable for arithmetic against `amount_usd`.

  /// Amount in the asset actually sent.
  assetAmount Decimal? @map("asset_amount") @db.Decimal(38, 18)

  /// Ticker of the asset actually sent ('BTC', 'USDT'). Audit only.
  asset String?

  /// USD per one unit of `asset` at the moment of receipt, as the gateway
  /// reported it. We never quote a rate ourselves — consilium §3: the gateway
  /// bears the volatility and we bear none.
  usdRateAtReceipt Decimal? @map("usd_rate_at_receipt") @db.Decimal(38, 18)

  /// When the valuation above was taken. NOT `created_at`: a late-credited
  /// payment is valued at receipt, and posted whenever we found out.
  valuedAt DateTime? @map("valued_at")

  /// BILL-0008 — for a 'refund'/'chargeback' row, the `idempotency_key` of the
  /// entry it reverses. A reversal that names no original is an unexplained
  /// negative entry, so the migration's CHECK requires it.
  ///
  /// A plain string rather than a self-referencing FK: the target is addressed
  /// by its idempotency key (the identity the payments module and the gateway
  /// share) rather than by our internal row id, which no caller outside this
  /// service ever sees.
  reversalOf String? @map("reversal_of")

  /// BILL-0008 (consilium §4.6) — WHO caused this movement. 'the ADMIN_TOKEN'
  /// is not an actor; every credit mutation must be attributable before live
  /// intake. Nullable for rows that predate attribution; the payment endpoint
  /// always writes it.
  actor String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([apiKeyId, createdAt])
  // Gifts are reported separately from payments in the cabinet (CTRL-0087), so
  // the history query filters on this.
  @@index([apiKeyId, entryType])
  // ARAS-0058 — the reconciler anti-joins Request against this column looking
  // for measured spend that never reached the ledger. Without an index that is
  // a sequential scan of the whole ledger on every sweep.
  @@index([requestId])
  // BILL-0008 — reconciling our ledger against the gateway's dashboard, and
  // resolving 'what did we already post for this gateway reference'.
  @@index([source, externalRef])
  // BILL-0008 — 'what reverses this payment', asked whenever a payment is
  // examined and on every reversal to refuse a double-reverse.
  @@index([reversalOf])
  @@map("credits_ledger")
}

/// ARAS-0058 — one row per REQUEST INTENT, which is not the same thing as one
/// row per attempt.
///
/// It carries two guarantees that the previous design could not express:
///
///  1. THE HOLD. `precheck()` used to be a bare read: N parallel requests all
///     read the same sufficient balance, all passed, all dispatched, and all
///     debited. `arcana` IS a parallel agent, so that is the normal traffic
///     shape rather than an edge case. A hold moves the estimate into
///     `credits_balance.held_usd` under a conditional UPDATE, so the (N-1)
///     losers of the race are refused BEFORE the provider is called — the only
///     point at which refusing is still free.
///
///  2. IDEMPOTENCY PER INTENT. The ledger key used to be `request:<uuid>`,
///     where the uuid was minted inside the logging path — so it was unique per
///     ATTEMPT and could only deduplicate a retry of the settle call itself,
///     which nothing ever performed. A client timeout plus a re-POST was a
///     second provider call and a second charge. `intentKey` is the caller's
///     own `Idempotency-Key`, so a replay resolves to THIS row, returns the
///     stored response, and calls neither the provider nor the ledger again.
///
/// When the caller supplies no header the key is server-minted and unique, so
/// the hold still works and replay simply never matches — no key, no promise.
model RequestIntent {
  id String @id @default(uuid())

  apiKeyId String @map("api_key_id")
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  /// Unique per KEY, not globally: two customers may legitimately choose the
  /// same idempotency key, and one must never be able to read the other's
  /// stored response by guessing it.
  intentKey String @map("intent_key")

  /// False when the key was server-minted because the caller sent no header.
  /// Kept so the replay path can tell "the client asked for idempotency" from
  /// "we invented a key to hang a hold on", and so adoption is measurable.
  clientSupplied Boolean @default(false) @map("client_supplied")

  /// The estimate reserved in `credits_balance.held_usd`. Zero when billing is
  /// not enforced, or for a catalogued free model.
  holdUsd Decimal @default(0) @map("hold_usd") @db.Decimal(12, 6)

  /// held     — reserved, in flight; the hold is live and counted in held_usd
  /// completed— dispatched and settled; the hold is released
  /// released — abandoned before or during dispatch; the hold is released
  /// expired  — the sweeper released a hold whose owner never came back
  state String @default("held")

  /// SHA-256 of the request payload this key was first used with.
  ///
  /// Stripe's rule, and the right one: reusing an idempotency key with a
  /// DIFFERENT body is a caller bug. Replaying the first body would hide that
  /// bug behind a correct-looking response, so the mismatch is reported
  /// instead. Hashed rather than stored, because the payload is the customer's
  /// prompt and this table is not where it belongs.
  payloadFingerprint String @map("payload_fingerprint")

  /// The Request row this intent produced, once there is one.
  requestId String? @map("request_id")

  /// The response returned to the caller, replayed verbatim on a repeat of the
  /// same intent key. Null when the response was too large to store, in which
  /// case a replay is refused rather than answered with a different body.
  response Json?

  /// After this instant the hold may be swept. A hold is a claim on the
  /// customer's money; a process that dies mid-dispatch must not be able to
  /// freeze funds forever.
  expiresAt DateTime @map("expires_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@unique([apiKeyId, intentKey])
  @@index([state, expiresAt])
  @@map("request_intent")
}

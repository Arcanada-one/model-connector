generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Request {
  id           String   @id @default(uuid())
  connector    String
  model        String?
  promptHash   String
  promptLength Int
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs    Int
  status       String // 'success', 'error', 'timeout', 'rate_limited'
  errorType    String?
  errorMessage String?
  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id])
  // CONN-0089 output-guard middleware envelope (nullable for backward-compat)
  repairReport Json?
  createdAt    DateTime @default(now())

  @@index([connector, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([status])
}

model ApiKey {
  id                String             @id @default(uuid())
  name              String
  keyHash           String             @unique
  rateLimit         Int                @default(60)
  active            Boolean            @default(true)
  requests          Request[]
  imageGenerations  ImageGeneration[]
  sttTranscriptions SttTranscription[]
  firstDispatchObservations FirstDispatchObservation[]
  // CONN-1665 — per-key access policy. Shape's single source of truth is the
  // Zod schema `apiKeyPolicySchema` in src/policy/policy.schema.ts — validated
  // at WRITE time by the admin API; never write this column outside that path.
  // Null = legacy unrestricted key (all providers/models, shared env keys).
  policy            Json?
  creditsBalance    CreditsBalance?
  creditsLedger     CreditsLedger[]
  createdAt         DateTime           @default(now())
}

model FirstDispatchObservation {
  id                         String   @id
  apiKeyId                   String
  apiKey                     ApiKey   @relation(fields: [apiKeyId], references: [id])
  observationKeySha256       String   @unique
  measurement                Json
  connector                  String
  requestedModel             String?
  requestPayloadDigestSha256 String
  requestPayloadBytes        Int
  observationBoundary        String
  connectorResponseId        String?
  observedModel              String?
  inputTokens                Int?
  outputTokens               Int?
  totalTokens                Int?
  costUsd                    Decimal? @db.Decimal(20, 12)
  latencyMs                  Int?
  outcome                    String?
  usageSource                String?
  persistence                String
  evidenceStatus             String
  authorization              String
  failureStage               String?
  receipt                    Json?
  receiptDigestSha256        String?  @unique
  state                      String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([apiKeyId, createdAt])
  @@index([state, createdAt])
}

model ConnectorAccount {
  id             String  @id @default(uuid())
  connector      String
  accountName    String
  credentials    String
  maxConcurrency Int     @default(1)
  active         Boolean @default(true)

  @@unique([connector, accountName])
}

// CONN-0052: Image Generation models
// PK uses app-side UUID v7 (uuidv7 lib) — NOT @default(uuid()) which is v4
// Migration deferred to Phase 1 (pnpm db:migrate)

model ImageGeneration {
  id            String   @id // UUID v7, set by application layer
  apiKeyId      String
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id])
  provider      String // 'vertex' | 'replicate' | 'openai-images'
  model         String
  prompt        String
  negativePrompt String?
  width         Int      @default(1024)
  height        Int      @default(1024)
  steps         Int?
  cfg           Float?   // classifier-free guidance scale
  seed          Int?
  aspectRatio   String?  // e.g. '16:9', '1:1'
  outputFormat  String   @default("png") // 'png' | 'jpeg' | 'webp'
  status        String   // 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled'
  resultUrl     String?  // presigned R2 URL or direct URL
  r2Key         String?  // R2 object key for storage management
  costUsd       Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs     Int?
  errorType     String?
  errorMessage  String?
  metadata      String?  // JSON blob for provider-specific fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  jobs          ImageJob[]

  @@index([provider, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([status])
}

model ImageJob {
  id              String          @id // UUID v7, set by application layer
  imageGenerationId String
  imageGeneration ImageGeneration @relation(fields: [imageGenerationId], references: [id])
  bullJobId       String?         // BullMQ job ID for async tracking
  attempt         Int             @default(1)
  status          String          // 'queued' | 'processing' | 'completed' | 'failed'
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([imageGenerationId])
  @@index([bullJobId])
  @@index([status, createdAt])
}

// CONN-0102: STT multi-provider router audit row
// PK = UUID v7 (app-side via uuidv7 lib) for time-sortable scans.
// CONN-0103: adds fallbackCount + driftStatus (Phase 1b cascade audit).
// CONN-0104: adds mode (sync|async) + jobId (uuidv7) for Phase 2 async pipeline.
model SttTranscription {
  id                   String   @id // UUID v7, set by application layer
  apiKeyId             String
  apiKey               ApiKey   @relation(fields: [apiKeyId], references: [id])
  provider             String // 'groq' | 'deepgram' | 'assemblyai' | 'openai' | 'local-whisper'
  model                String
  language             String?
  audioBytes           Int
  audioDurationSeconds Float?
  mimeType             String
  transcriptionPreview String // first 80 chars of returned transcription (PII surface — keep short)
  costUsd              Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs            Int
  status               String // 'success' | 'error' | 'queued' | 'processing' (async-only states)
  errorType            String? // includes 'drift' from Phase 1b
  errorMessage         String?
  requestId            String?
  fallbackCount        Int      @default(0) // cascade hops before this row landed
  driftStatus          String? // null | 'schema_pass' | 'schema_fail' (Phase 1b drift detection)
  mode                 String   @default("sync") // 'sync' | 'async' (CONN-0104)
  jobId                String?  @unique // BullMQ job id (uuidv7) — only set for mode='async'
  createdAt            DateTime @default(now())

  @@index([provider, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([status])
}

// CONN-0245: DB as single source of truth for the model catalog.
// Populated exclusively by CatalogRefreshService (cron full-refresh +
// interval status-refresh) — the getCatalog() request path only ever reads
// this table (+ optional Redis cache), never calls a provider directly.
// Rows are never deleted: when a model disappears from a provider's live
// list, `absent` flips to true and the last-known data is retained for
// history/audit instead of losing the row.
model ModelCatalog {
  id                 String   @id @default(cuid())
  connector          String
  model              String
  modality           String
  status             String // "online" | "offline"
  lastChecked        DateTime
  supportsStreaming  Boolean  @default(false)
  supportsJsonSchema Boolean  @default(false)
  supportsTools      Boolean  @default(false)
  inputPerMTok       Float?
  outputPerMTok      Float?
  priceUnit          String   @default("USD/1M tokens")
  tier               String // "free" | "paid" | "unknown"
  free               Boolean  @default(false)
  // QA FIX B (Finding 1) — the legacy MC-side price multiplier (0 = free;
  // 1 = standard; null = unknown; OPENMODEL_CATALOGUE-sourced). Persisted
  // verbatim (not consulted for tier/free — see catalog-mapper.ts deriveTier)
  // so the external site's `cheap`/`priceMultiplier` fields survive the DB
  // round-trip unchanged instead of being fabricated on read.
  priceMultiplier    Float?
  contextWindow      Int?
  maxOutputTokens    Int?
  endpoint           String?
  executableHere     Boolean  @default(false)
  // CONN-0244 — per-provider USE access (`ProviderAccess.use`), persisted
  // verbatim so the read path can reconstruct the `access:read-only` tag.
  // NOT a compound of useEnabled && executableHere — availability for
  // routing is derived separately (see `available`, computed from `status`
  // at persist time in catalog-mapper.ts's entryToRow/rowToEntry).
  routable           Boolean  @default(false)
  firstSeen          DateTime @default(now())
  lastSeen           DateTime
  absent             Boolean  @default(false)
  // CONN-1646 — identity/provenance are nullable only for honest legacy rows
  // that predate transactional snapshots.
  snapshotId         String?
  contentFingerprint String?
  observedAt         DateTime
  source             String   @default("legacy-unknown")
  freshness          String   @default("unknown")
  absentSince        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  snapshot           CatalogSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@unique([connector, model])
  @@index([modality])
  @@index([status])
  @@index([snapshotId])
  @@map("model_catalog")
}

// CONN-1646 — one immutable identity for every applied provider observation,
// including sourced non-authoritative static boot floors.
model CatalogSnapshot {
  id            String              @id @default(cuid())
  connector     String
  fingerprint   String
  source        String
  observedAt    DateTime
  freshness     String
  authoritative Boolean
  rowCount      Int
  createdAt     DateTime            @default(now())
  modelRows     ModelCatalog[]
  driftEvents   CatalogDriftEvent[]

  @@index([connector, observedAt])
  @@map("catalog_snapshots")
}

// CONN-1646 — append-only provider drift derived inside the same serializable
// transaction as its snapshot and model row mutations.
model CatalogDriftEvent {
  id                String          @id @default(cuid())
  snapshotId        String
  connector         String
  model             String
  changeType        String
  beforeFingerprint String?
  afterFingerprint  String?
  changedFields     Json
  observedAt        DateTime
  createdAt         DateTime        @default(now())
  snapshot          CatalogSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([connector, observedAt])
  @@index([snapshotId])
  @@map("catalog_drift_events")
}

// CONN-0245-EXT — per-provider READ/USE access state. DB is authoritative;
// config (CATALOG_PROVIDER_USE_DEFAULT_OFF) only seeds defaults for a
// provider the FIRST time it's seen (create-only — see
// ProviderAccessService.seedDefaults). readEnabled gates catalog visibility;
// useEnabled gates whether MC routes traffic to it (execute()/cascade).
// Driving case: OpenModel is paid and the operator hasn't topped up ->
// readEnabled=true (still shown, real prices, not falsely free) /
// useEnabled=false (never routed).
model ProviderAccess {
  provider    String   @id
  readEnabled Boolean  @default(true)
  useEnabled  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("provider_access")
}

// ARAS-0064 — credit balance and ledger.
//
// The connector already MEASURED money (`Request.costUsd`) without ever
// SPENDING it. These two models close that gap: the ledger is the append-only
// record of every movement, and the balance is a materialised running total so
// a precheck is one indexed read rather than a sum over history.
//
// The ledger is the source of truth. If the two ever disagree, rebuild the
// balance from the ledger, never the other way round.
model CreditsBalance {
  apiKeyId   String   @id @map("api_key_id")
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  // 12,6 rather than Request.costUsd's 10,6: a balance accumulates many
  // requests, so it needs headroom the per-request column does not.
  balanceUsd Decimal  @default(0) @map("balance_usd") @db.Decimal(12, 6)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("credits_balance")
}

model CreditsLedger {
  id String @id @default(uuid())

  apiKeyId String @map("api_key_id")
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  // Signed: positive credits the account, negative debits it. One column rather
  // than a type discriminator plus a magnitude, so the balance is a plain SUM
  // and no reader can misinterpret a sign convention.
  amountUsd Decimal @map("amount_usd") @db.Decimal(12, 6)

  reason String

  // ARAS-0071 — what KIND of movement this is, as a first-class column rather
  // than a substring of `reason`. A gift must be distinguishable from money the
  // customer paid: they are the same arithmetic and completely different facts,
  // and an accounting history that cannot tell them apart cannot be audited.
  // Free-text `reason` is not enough — it is operator-supplied and unqueryable.
  //
  // 'charge' = spend debited for a request
  // 'gift'   = credit granted by an operator, not paid for
  // 'credit' = credit from any other source (kept for entries pre-dating gifts)
  entryType String @default("charge") @map("entry_type")

  // The anti-double-charge invariant, enforced by the DATABASE rather than by
  // application logic: a retried commit reuses its key and the unique
  // constraint rejects the second insert. A check in code would race.
  idempotencyKey String @unique @map("idempotency_key")

  // Set for a debit that settles a specific request; null for a manual credit.
  requestId String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([apiKeyId, createdAt])
  // Gifts are reported separately from payments in the cabinet (CTRL-0087), so
  // the history query filters on this.
  @@index([apiKeyId, entryType])
  @@map("credits_ledger")
}

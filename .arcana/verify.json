{
  "schema": "VerifyProfile/v1",
  "deployables": {
    ".": {
      "tsconfig": [
        "tsconfig.json",
        "tsconfig.build.json",
        "tsconfig.ci.json",
        "tsconfig.test.json",
        ".arcana/tsconfig.mjs.json"
      ],
      "tsconfig_test": ".arcana/tsconfig.mjs.json",
      "full_test": [
        "bash",
        "scripts/graph-full-suite-isolated.sh",
        "."
      ],
      "full_test_parity_setup": [
        [
          "bash",
          "scripts/graph-parity-setup.sh"
        ]
      ],
      "full_test_arms": [
        {
          "name": "vitest-default",
          "requires": "stub_ok"
        },
        {
          "name": "integration-offline-contracts",
          "requires": "stub_ok"
        },
        {
          "name": "authored-template",
          "requires": "stub_ok"
        },
        {
          "name": "regression",
          "requires": "stub_ok"
        },
        {
          "name": "integration-disposable-store",
          "requires": "real_disposable"
        },
        {
          "name": "integration-external-provider",
          "requires": "real_external"
        },
        {
          "name": "app-e2e",
          "requires": "real_disposable"
        }
      ]
    },
    "packages/sdk-python": {
      "full_test": [
        "bash",
        "../../scripts/graph-full-suite-isolated.sh",
        "packages/sdk-python"
      ]
    },
    "packages/sdk-ts": {
      "full_test": [
        "bash",
        "../../scripts/graph-full-suite-isolated.sh",
        "packages/sdk-ts"
      ]
    },
    "watcher": {
      "full_test": [
        "bash",
        "../scripts/graph-full-suite-isolated.sh",
        "watcher"
      ]
    }
  }
}
